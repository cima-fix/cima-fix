# Neon: use the `dev` branch locally (SDD 15.2)
# Pooled connection, used by the API
DATABASE_URL=
# Direct connection, only used by `drizzle-kit migrate`
DATABASE_URL_UNPOOLED=

# Secret Vercel sends when calling the cron task
CRON_SECRET=

# Public URL: used in email links and the Origin check
# Local: http://localhost:5173
APP_BASE_URL=

# Google OAuth client ID. The SPA reads the same value as VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# One folder per environment (local, preview, production)
CLOUDINARY_FOLDER=

# Resend
RESEND_API_KEY=
MAIL_FROM=

# Upstash Redis (generic rate limiter)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Initial campus on the map
DEFAULT_CAMPUS_SLUG=sauzal
