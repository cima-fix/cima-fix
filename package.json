{
  "name": "cima-fix",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "dev:server": "node --env-file-if-exists=.env --watch src/server/dev.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "campus:create": "node --env-file-if-exists=.env scripts/campus-create.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@neondatabase/serverless": "^1.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@upstash/ratelimit": "^2.2.2",
    "@upstash/redis": "^1.41.1",
    "@vercel/functions": "^3.11.3",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.4",
    "hono": "^4.13.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.6.0",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.11",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
